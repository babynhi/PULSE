{
  "expo": {
    "name": "PULSE",
    "slug": "pulse",
    "scheme": "pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.babynhi.pulse"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "PULSE uses Bluetooth to detect players near you during a game."
        }
      ]
    ]
  }
}
